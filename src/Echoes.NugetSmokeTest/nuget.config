<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local feeds built by GeneratePackageOnBuild — always up to date after a solution build -->
    <add key="Echoes-local-Debug" value="../Echoes/bin/Debug" />
    <add key="Echoes-local-Release" value="../Echoes/bin/Release" />
    <add key="Echoes.Generator-local-Debug" value="../Echoes.Generator/bin/Debug" />
    <add key="Echoes.Generator-local-Release" value="../Echoes.Generator/bin/Release" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
